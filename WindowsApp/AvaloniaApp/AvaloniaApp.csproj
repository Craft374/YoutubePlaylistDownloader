<Project Sdk="Microsoft.NET.Sdk">

  <!-- Avalonia 시제품: 새 다운로드 화면과 옵션 패널만 있습니다. SukiUI·Semi 테마를 바꿔 끼워 봅니다.
       Avalonia XAML은 어느 OS에서나 컴파일되므로 Mac에서 dotnet run으로 바로 띄워 볼 수 있습니다. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>YPDDesktop</AssemblyName>
    <RootNamespace>YPD.Desktop</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\App\Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- SukiUI 7.0.1은 Avalonia 12.0.3 이상, Semi 12.1.0.2는 12.1.0 이상을 요구합니다. -->
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="SukiUI" Version="7.0.1" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.2" />
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\App\Assets\AppIcon.ico" Link="Assets\AppIcon.ico" />
  </ItemGroup>

</Project>
