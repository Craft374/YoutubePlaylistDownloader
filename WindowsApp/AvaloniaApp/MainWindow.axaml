<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:YPD.Desktop"
        x:Class="YPD.Desktop.MainWindow"
        Title="YouTube Playlist Downloader"
        Icon="avares://YoutubePlaylistDownloader/Assets/AppIcon.ico"
        Width="1080" Height="700" MinWidth="960" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource YpdWindowBackground}">
  <!-- 사이드바(232) | 머리글 + 화면 | 옵션 패널(300, 오른쪽에서 들어오고 오른쪽으로 나감).
       사이드바는 OS 재질(Windows 11 Mica, 맥 비브랜시)을 받을 수 있으면 반투명, 아니면 단색입니다(MainWindow.axaml.cs). -->
  <Grid ColumnDefinitions="232,*">

    <!-- 사이드바 -->
    <Border Name="Sidebar" Background="{DynamicResource YpdSidebarBackground}" BorderBrush="{DynamicResource YpdDivider}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10,0,10,12">
        <!-- 맨 위 빈칸: 맥에서는 신호등 버튼 자리이자 창 끌기 영역입니다. -->
        <Border Name="SidebarDrag" DockPanel.Dock="Top" Height="44" Background="Transparent" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,0,16">
          <local:Logo Width="26" Height="26" />
          <TextBlock Text="YT Downloader" Classes="headline" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 아래쪽: 구성 요소 안내, 설정 -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="10">
          <Border Name="ToolBanner" Classes="card" Padding="12,10" IsVisible="False">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <local:Icon Data="{StaticResource IconAlert}" Classes="warning" Width="14" Height="14" />
                <TextBlock Text="{local:Tr 'Components'}" FontSize="12" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock Name="ToolBannerText" Classes="caption" />
              <Button Name="InstallYtdlp" Content="{local:Tr 'Install yt-dlp'}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <RadioButton Name="NavSettings" Classes="nav" GroupName="nav">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <local:Icon Data="{StaticResource IconSettings}" />
              <TextBlock Text="{local:Tr 'Settings'}" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
        </StackPanel>

        <StackPanel Spacing="2">
          <RadioButton Name="NavNew" Classes="nav" GroupName="nav" IsChecked="True">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <local:Icon Data="{StaticResource IconLink}" />
              <TextBlock Text="{local:Tr 'New Download'}" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton Name="NavBulk" Classes="nav" GroupName="nav">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <local:Icon Data="{StaticResource IconList}" />
              <TextBlock Text="{local:Tr 'Bulk Download'}" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton Name="NavQueue" Classes="nav" GroupName="nav">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <local:Icon Data="{StaticResource IconDownload}" />
                <TextBlock Text="{local:Tr 'Downloads'}" VerticalAlignment="Center" />
              </StackPanel>
              <!-- 진행 중인 작업 수 -->
              <Border Name="Badge" Grid.Column="1" Classes="badge" VerticalAlignment="Center" IsVisible="False">
                <TextBlock Name="BadgeText" Foreground="White" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 머리글(화면 제목 + 옵션 버튼)과 그 아래 화면 | 옵션 패널 -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*" ColumnDefinitions="*,Auto" Background="{DynamicResource YpdWindowBackground}">
      <Border Name="Header" Grid.ColumnSpan="2" Background="Transparent" Padding="28,0,14,0" Height="56">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Name="PageTitle" Classes="title" VerticalAlignment="Center" />
          <ToggleButton Name="OptionsToggle" Grid.Column="1" VerticalAlignment="Center"
                        ToolTip.Tip="{local:Tr 'Show or hide download options'}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <local:Icon Data="{StaticResource IconSliders}" Width="16" Height="16" Stroke="{Binding $parent[ToggleButton].Foreground}" />
              <TextBlock Text="{local:Tr 'Download Options'}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
        </Grid>
      </Border>

      <!-- 화면 네 개를 모두 붙여 두고 하나만 보입니다. 화면을 오가도 입력한 내용과 진행 중인 일괄 추가가 남습니다. -->
      <Panel Name="Pages" Grid.Row="1" />

      <!-- 폭이 0↔300으로 움직이고, 안의 패널은 왼쪽에 붙어 있어 오른쪽 끝에서 미끄러져 들어옵니다. -->
      <Border Name="OptionsHost" Grid.Row="1" Grid.Column="1" Width="0" ClipToBounds="True" IsVisible="False">
        <local:OptionsPanel Name="Options" Width="300" HorizontalAlignment="Left" />
      </Border>
    </Grid>
  </Grid>
</Window>
