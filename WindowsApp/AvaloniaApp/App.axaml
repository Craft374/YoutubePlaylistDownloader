<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:YPD.Desktop"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="YPD.Desktop.App"
             Name="YouTube Playlist Downloader"
             RequestedThemeVariant="Default">
  <!-- 컨트롤은 Semi가 그리고, 여기서는 색·글·움직임을 애플 앱처럼 맞춥니다.
       색은 애플 시스템 색(라벨 4단계, 그룹 배경, 구분선, 초록·주황·빨강)에 가깝게, 강조색만 로고 색입니다.
       Application.Resources가 Application.Styles(Semi)보다 먼저 찾아지므로 같은 이름의 Semi 색을 덮어씁니다. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- 화면: 옅은 회색 바탕 위 흰 카드(그룹 목록) -->
          <SolidColorBrush x:Key="YpdWindowBackground" Color="#F5F5F7" />
          <SolidColorBrush x:Key="YpdSidebarBackground" Color="#ECECEF" />
          <!-- 반투명 재질(Mica·맥 비브랜시) 위에 얹는 사이드바: 무거운 재질로 구역을 나눕니다. -->
          <SolidColorBrush x:Key="YpdSidebarMaterial" Color="#99ECECEF" />
          <SolidColorBrush x:Key="YpdCardBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="YpdCardBorder" Color="#14000000" />
          <SolidColorBrush x:Key="YpdDivider" Color="#1A3C3C43" />
          <SolidColorBrush x:Key="YpdTextPrimary" Color="#1D1D1F" />
          <SolidColorBrush x:Key="YpdTextSecondary" Color="#6E6E73" />
          <SolidColorBrush x:Key="YpdTextTertiary" Color="#A1A1A6" />
          <SolidColorBrush x:Key="YpdHover" Color="#0A000000" />
          <SolidColorBrush x:Key="YpdNavSelected" Color="#14000000" />
          <SolidColorBrush x:Key="YpdSegmentTrack" Color="#E8E8ED" />
          <SolidColorBrush x:Key="YpdSegmentThumb" Color="#FFFFFF" />
          <SolidColorBrush x:Key="YpdAccentSoft" Color="#1AE5306B" />
          <SolidColorBrush x:Key="YpdSuccess" Color="#28A745" />
          <SolidColorBrush x:Key="YpdWarning" Color="#F08A00" />
          <SolidColorBrush x:Key="YpdDanger" Color="#E5372B" />
          <BoxShadows x:Key="YpdRaised">0 1 2 0 #1F000000</BoxShadows>
          <BoxShadows x:Key="YpdCardShadow">0 1 3 0 #0F000000</BoxShadows>

          <!-- Semi 색 덮어쓰기: 강조색(스위치·포커스·선택), 글자색, 바탕 -->
          <SolidColorBrush x:Key="SemiColorPrimary" Color="#E5306B" />
          <SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#D42A62" />
          <SolidColorBrush x:Key="SemiColorPrimaryActive" Color="#BF2457" />
          <SolidColorBrush x:Key="SemiColorPrimaryDisabled" Color="#66E5306B" />
          <SolidColorBrush x:Key="SemiColorPrimaryLight" Color="#14E5306B" />
          <SolidColorBrush x:Key="SemiColorPrimaryLightPointerover" Color="#22E5306B" />
          <SolidColorBrush x:Key="SemiColorPrimaryLightActive" Color="#30E5306B" />
          <SolidColorBrush x:Key="SemiColorFocusBorder" Color="#E5306B" />
          <SolidColorBrush x:Key="SemiColorText0" Color="#1D1D1F" />
          <SolidColorBrush x:Key="SemiColorText1" Color="#3A3A3C" />
          <SolidColorBrush x:Key="SemiColorText2" Color="#6E6E73" />
          <SolidColorBrush x:Key="SemiColorText3" Color="#A1A1A6" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="YpdWindowBackground" Color="#1C1C1E" />
          <SolidColorBrush x:Key="YpdSidebarBackground" Color="#252527" />
          <SolidColorBrush x:Key="YpdSidebarMaterial" Color="#80202022" />
          <SolidColorBrush x:Key="YpdCardBackground" Color="#2C2C2E" />
          <SolidColorBrush x:Key="YpdCardBorder" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="YpdDivider" Color="#26FFFFFF" />
          <SolidColorBrush x:Key="YpdTextPrimary" Color="#F5F5F7" />
          <SolidColorBrush x:Key="YpdTextSecondary" Color="#98989D" />
          <SolidColorBrush x:Key="YpdTextTertiary" Color="#636366" />
          <SolidColorBrush x:Key="YpdHover" Color="#10FFFFFF" />
          <SolidColorBrush x:Key="YpdNavSelected" Color="#1FFFFFFF" />
          <SolidColorBrush x:Key="YpdSegmentTrack" Color="#1C1C1E" />
          <SolidColorBrush x:Key="YpdSegmentThumb" Color="#48484A" />
          <SolidColorBrush x:Key="YpdAccentSoft" Color="#2EFF6A8E" />
          <SolidColorBrush x:Key="YpdSuccess" Color="#30D158" />
          <SolidColorBrush x:Key="YpdWarning" Color="#FF9F0A" />
          <SolidColorBrush x:Key="YpdDanger" Color="#FF453A" />
          <BoxShadows x:Key="YpdRaised">0 1 2 0 #66000000</BoxShadows>
          <BoxShadows x:Key="YpdCardShadow">0 1 3 0 #33000000</BoxShadows>

          <!-- 어두운 화면에서는 강조색을 조금 밝게 써야 대비가 맞습니다. -->
          <SolidColorBrush x:Key="SemiColorPrimary" Color="#FF4F82" />
          <SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#FF6893" />
          <SolidColorBrush x:Key="SemiColorPrimaryActive" Color="#FF80A4" />
          <SolidColorBrush x:Key="SemiColorPrimaryDisabled" Color="#66FF4F82" />
          <SolidColorBrush x:Key="SemiColorPrimaryLight" Color="#1FFF4F82" />
          <SolidColorBrush x:Key="SemiColorPrimaryLightPointerover" Color="#2EFF4F82" />
          <SolidColorBrush x:Key="SemiColorPrimaryLightActive" Color="#3DFF4F82" />
          <SolidColorBrush x:Key="SemiColorFocusBorder" Color="#FF4F82" />
          <SolidColorBrush x:Key="SemiColorText0" Color="#F5F5F7" />
          <SolidColorBrush x:Key="SemiColorText1" Color="#E5E5EA" />
          <SolidColorBrush x:Key="SemiColorText2" Color="#98989D" />
          <SolidColorBrush x:Key="SemiColorText3" Color="#636366" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- 로고 색(MacApp LogoView와 같음). 화면 모드와 상관없이 같은 색입니다. -->
      <SolidColorBrush x:Key="YpdAccent" Color="#E5306B" />
      <LinearGradientBrush x:Key="YpdBrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#FF6A5C" Offset="0" />
        <GradientStop Color="#E5306B" Offset="1" />
      </LinearGradientBrush>
      <!-- Semi의 ToggleSwitch는 빈 글 칸에도 좌우 8px을 남겨 오른쪽 끝이 콤보 상자와 어긋납니다. -->
      <Thickness x:Key="ToggleSwitchOnContentMargin">0</Thickness>
      <FontFamily x:Key="YpdMonospace">Cascadia Mono, Consolas, SF Mono, Menlo, monospace</FontFamily>

      <!-- 선 아이콘(24×24 격자, 굵기 2, 둥근 끝). local:Icon이 그립니다. -->
      <StreamGeometry x:Key="IconLink">M10 13 A5 5 0 0 0 17.54 13.54 L20.54 10.54 A5 5 0 0 0 13.47 3.47 L11.75 5.18 M14 11 A5 5 0 0 0 6.46 10.46 L3.46 13.46 A5 5 0 0 0 10.53 20.53 L12.24 18.82</StreamGeometry>
      <StreamGeometry x:Key="IconList">M8 6 L21 6 M8 12 L21 12 M8 18 L21 18 M3 6 L3.01 6 M3 12 L3.01 12 M3 18 L3.01 18</StreamGeometry>
      <StreamGeometry x:Key="IconDownload">M21 15 L21 19 A2 2 0 0 1 19 21 L5 21 A2 2 0 0 1 3 19 L3 15 M7 10 L12 15 L17 10 M12 15 L12 3</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">M12 9 A3 3 0 1 1 12 15 A3 3 0 1 1 12 9 Z M12 2 L12 4.5 M12 19.5 L12 22 M2 12 L4.5 12 M19.5 12 L22 12 M4.93 4.93 L6.7 6.7 M17.3 17.3 L19.07 19.07 M4.93 19.07 L6.7 17.3 M17.3 6.7 L19.07 4.93 M12 5 A7 7 0 1 1 12 19 A7 7 0 1 1 12 5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSliders">M4 21 L4 14 M4 10 L4 3 M12 21 L12 12 M12 8 L12 3 M20 21 L20 16 M20 12 L20 3 M1 14 L7 14 M9 8 L15 8 M17 16 L23 16</StreamGeometry>
      <StreamGeometry x:Key="IconClipboard">M16 4 L18 4 A2 2 0 0 1 20 6 L20 20 A2 2 0 0 1 18 22 L6 22 A2 2 0 0 1 4 20 L4 6 A2 2 0 0 1 6 4 L8 4 M9 2 L15 2 A1 1 0 0 1 16 3 L16 5 A1 1 0 0 1 15 6 L9 6 A1 1 0 0 1 8 5 L8 3 A1 1 0 0 1 9 2 Z</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M18 6 L6 18 M6 6 L18 18</StreamGeometry>
      <StreamGeometry x:Key="IconCheckCircle">M22 11.08 L22 12 A10 10 0 1 1 16.07 2.86 M22 4 L12 14.01 L9 11.01</StreamGeometry>
      <StreamGeometry x:Key="IconAlert">M10.29 3.86 L1.82 18 A2 2 0 0 0 3.53 21 L20.47 21 A2 2 0 0 0 22.18 18 L13.71 3.86 A2 2 0 0 0 10.29 3.86 Z M12 9 L12 13 M12 17 L12.01 17</StreamGeometry>
      <StreamGeometry x:Key="IconXCircle">M12 2 A10 10 0 1 1 12 22 A10 10 0 1 1 12 2 Z M15 9 L9 15 M9 9 L15 15</StreamGeometry>
      <StreamGeometry x:Key="IconCircle">M12 2 A10 10 0 1 1 12 22 A10 10 0 1 1 12 2 Z</StreamGeometry>
      <StreamGeometry x:Key="IconMinusCircle">M12 2 A10 10 0 1 1 12 22 A10 10 0 1 1 12 2 Z M8 12 L16 12</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M22 19 A2 2 0 0 1 20 21 L4 21 A2 2 0 0 1 2 19 L2 5 A2 2 0 0 1 4 3 L9 3 L11 6 L20 6 A2 2 0 0 1 22 8 Z</StreamGeometry>
      <StreamGeometry x:Key="IconReset">M1 4 L1 10 L7 10 M3.51 15 A9 9 0 1 0 5.64 5.64 L1 10</StreamGeometry>
      <StreamGeometry x:Key="IconPlus">M12 5 L12 19 M5 12 L19 12</StreamGeometry>
      <StreamGeometry x:Key="IconPlay">M5 3 L19 12 L5 21 Z</StreamGeometry>
      <StreamGeometry x:Key="IconStop">M6 6 L18 6 L18 18 L6 18 Z</StreamGeometry>
      <StreamGeometry x:Key="IconRetry">M23 4 L23 10 L17 10 M20.49 15 A9 9 0 1 1 18.36 5.64 L23 10</StreamGeometry>
      <StreamGeometry x:Key="IconTrash">M3 6 L21 6 M19 6 L19 20 A2 2 0 0 1 17 22 L7 22 A2 2 0 0 1 5 20 L5 6 M8 6 L8 4 A2 2 0 0 1 10 2 L14 2 A2 2 0 0 1 16 4 L16 6</StreamGeometry>
      <StreamGeometry x:Key="IconChevronDown">M6 9 L12 15 L18 9</StreamGeometry>
      <StreamGeometry x:Key="IconChevronUp">M18 15 L12 9 L6 15</StreamGeometry>
      <StreamGeometry x:Key="IconBroom">M3 21 L10 14 M14 4 L20 10 L12 18 L6 12 Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <semi:SemiTheme />

    <!-- 글: 시스템 글꼴(Segoe UI / SF)을 쓰고, 큰 글일수록 자간을 좁힙니다(작은 글은 0). -->
    <Style Selector="TextBlock.largeTitle">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="-0.5" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="-0.3" />
    </Style>
    <Style Selector="TextBlock.headline">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource YpdTextSecondary}" />
    </Style>
    <Style Selector="TextBlock.tertiary">
      <Setter Property="Foreground" Value="{DynamicResource YpdTextTertiary}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource YpdTextSecondary}" />
    </Style>
    <Style Selector="TextBlock.danger">
      <Setter Property="Foreground" Value="{DynamicResource YpdDanger}" />
    </Style>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="{DynamicResource YpdWarning}" />
    </Style>
    <Style Selector="ProgressBar.warning">
      <Setter Property="Foreground" Value="{DynamicResource YpdWarning}" />
    </Style>
    <Style Selector="TextBlock.hero">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="-0.6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <!-- 구역 제목: 카드 바로 위의 작은 글(애플 설정 앱의 그룹 머리글). -->
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource YpdTextSecondary}" />
      <Setter Property="Margin" Value="4,20,0,8" />
    </Style>
    <Style Selector="TextBlock.rowLabel">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector=":is(TextBlock).mono">
      <Setter Property="FontFamily" Value="{StaticResource YpdMonospace}" />
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="{StaticResource YpdMonospace}" />
    </Style>

    <!-- 스위치는 줄 이름이 설명하므로 켬/끔 글을 빼고 오른쪽 끝을 맞춥니다. -->
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- 카드(그룹)와 카드 안의 줄. 테두리는 머리카락 굵기, 그림자는 아주 옅게 띄웁니다. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource YpdCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource YpdCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BoxShadow" Value="{DynamicResource YpdCardShadow}" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="MinHeight" Value="46" />
    </Style>
    <!-- 줄 사이 구분선: 보이는 줄 사이에만 긋습니다(Rows.UpdateDividers). -->
    <Style Selector="Border.row.divided">
      <Setter Property="BorderBrush" Value="{DynamicResource YpdDivider}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- 선 아이콘 -->
    <Style Selector="local|Icon">
      <Setter Property="Stroke" Value="{DynamicResource YpdTextSecondary}" />
    </Style>
    <Style Selector="local|Icon.success">
      <Setter Property="Stroke" Value="{DynamicResource YpdSuccess}" />
    </Style>
    <Style Selector="local|Icon.warning">
      <Setter Property="Stroke" Value="{DynamicResource YpdWarning}" />
    </Style>
    <Style Selector="local|Icon.danger">
      <Setter Property="Stroke" Value="{DynamicResource YpdDanger}" />
    </Style>
    <Style Selector="local|Icon.tertiary">
      <Setter Property="Stroke" Value="{DynamicResource YpdTextTertiary}" />
    </Style>

    <!-- 누르는 순간 바로 조금 작아지고(손을 대자마자 반응), 떼면 제자리로 돌아옵니다. -->
    <Style Selector="Button, ToggleButton">
      <Setter Property="RenderTransform" Value="none" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pressed, ToggleButton:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <!-- 사이드바 항목: 둥근 사각형, 고르면 옅게 채우고 아이콘이 강조색. -->
    <Style Selector="RadioButton.nav">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="bg" Background="Transparent" CornerRadius="8" Padding="10,7">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource YpdHover}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource YpdNavSelected}" />
    </Style>
    <Style Selector="RadioButton.nav:checked local|Icon">
      <Setter Property="Stroke" Value="{DynamicResource YpdAccent}" />
    </Style>
    <Style Selector="RadioButton.nav:checked TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.nav:focus-visible /template/ Border#bg">
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorFocusBorder}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- 세그먼트: 홈 안에서 고른 칸만 떠오릅니다(맥의 세그먼트 컨트롤). -->
    <Style Selector="RadioButton.segment">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="bg" Background="Transparent" CornerRadius="7" Padding="10,5">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource YpdHover}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource YpdSegmentThumb}" />
      <Setter Property="BoxShadow" Value="{DynamicResource YpdRaised}" />
    </Style>
    <Style Selector="RadioButton.segment:checked TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.segment:focus-visible /template/ Border#bg">
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorFocusBorder}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.segmentTrack">
      <Setter Property="Background" Value="{DynamicResource YpdSegmentTrack}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="2" />
    </Style>

    <!-- 로고 색 버튼(다운로드, 모두 다운로드): 화면마다 가장 중요한 동작 하나에만 씁니다. -->
    <Style Selector="Button.brand">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="bg" Background="{DynamicResource YpdBrandGradient}" CornerRadius="8" Padding="18,8">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.brand:pointerover /template/ Border#bg">
      <Setter Property="Opacity" Value="0.92" />
    </Style>
    <Style Selector="Button.brand:pressed /template/ Border#bg">
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Button.brand:disabled /template/ Border#bg">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.brand:focus-visible /template/ Border#bg">
      <Setter Property="BorderBrush" Value="{DynamicResource YpdTextPrimary}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- 테두리 없는 아이콘 버튼(붙여넣기, 지우기, 작업 줄의 버튼) -->
    <Style Selector="Button.icon">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource YpdHover}" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource YpdNavSelected}" />
    </Style>
    <Style Selector="Button.icon:focus-visible /template/ Border#bg">
      <Setter Property="BorderBrush" Value="{DynamicResource SemiColorFocusBorder}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.icon:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- 다운로드 개수 배지(사이드바) -->
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource YpdAccent}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="5,0" />
    </Style>

    <!-- 진행 막대는 값이 바뀔 때 끊기지 않고 따라갑니다(새 값이 오면 지금 위치에서 다시 출발). -->
    <Style Selector="ProgressBar">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Value" Duration="0:0:0.25" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
  </Application.Styles>
</Application>
